# --- Groq (LLM reasoning) -------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Hindsight (agent memory) --------------------------------------------
# Hindsight Cloud: https://api.hindsight.vectorize.io  (get a key at ui.hindsight.vectorize.io)
# Self-hosted:     http://localhost:8888
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=oncall-demo

# --- Optional -------------------------------------------------------------
# deterministic | agentic   (agentic = LLM picks tools, falls back to deterministic)
AGENT_MODE=deterministic
# auto | hindsight | local   (hindsight makes connection failures visible; local is demo-only)
MEMORY_BACKEND=hindsight
# Seconds per Hindsight request.
HINDSIGHT_TIMEOUT=60
